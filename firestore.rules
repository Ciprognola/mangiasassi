rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isDev() {
      return signedIn() && exists(/databases/$(database)/documents/devs/$(request.auth.uid));
    }
    function reserved() {
      return ['master','dev1','dev2','dev3','dev4','dev5','admin','algidone','gamblador','professore','mrstone','usagi'];
    }
    function validName(u) {
      return u is string && u.matches('^[a-z0-9_-]{3,16}$') && !(u in reserved());
    }
    match /devs/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
    match /players/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['username','created','confirmed'])
        && request.resource.data.keys().hasAll(['username','created','confirmed'])
        && validName(request.resource.data.username)
        && request.auth.token.email == request.resource.data.username + '@mangiasassi.invalid'
        && request.resource.data.created == request.time
        && request.resource.data.confirmed == request.time;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['confirmed'])
        && request.resource.data.confirmed == request.time;
      allow delete: if false;
    }
    match /delreq/{username} {
      allow create: if validName(username)
        && request.resource.data.keys().hasOnly(['ts'])
        && request.resource.data.ts == request.time;
      allow read, update, delete: if false;
    }
    match /saves/{docId} {
      function mine() { return request.auth != null && (docId == request.auth.uid || docId == request.auth.uid + '_dev'); }
      function ok() { return request.resource.data.keys().hasOnly(['data','rev','ts','ver'])
        && request.resource.data.data is string && request.resource.data.data.size() <= 900000
        && request.resource.data.ver is string && request.resource.data.ts == request.time; }
      allow read: if mine();
      allow create: if mine() && ok() && request.resource.data.rev == 1;
      allow update: if mine() && ok() && request.resource.data.rev == resource.data.rev + 1;
      allow delete: if false;
    }
    match /bugs/{id} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000
        && request.resource.data.keys().hasOnly(['uid','text','screen','version','char','ts','ua','meta']);
      allow read, update, delete: if false;
    }
    match /edits/{id} {
      allow create: if isDev()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','acct','kind','char','screen','target','locator','before','value','note','base','ts','meta'])
        && request.resource.data.kind in ['text','colour','scale']
        && request.resource.data.value is string
        && request.resource.data.value.size() <= 500
        && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 300));
      allow read, update, delete: if false;
    }
  }
}
